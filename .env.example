# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI text generation. If neither key is set, Meridian uses deterministic MVP fallback output.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-3-5-haiku-latest

# Future integrations
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
